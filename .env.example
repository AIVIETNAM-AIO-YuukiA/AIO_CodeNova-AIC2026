# Copy to .env and fill in.

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codenova_frames
QDRANT_API_KEY=

# Elasticsearch (OCR/ASR text index)
ELASTIC_URL=http://localhost:8882
ELASTIC_INDEX=codenova_text
ELASTIC_API_KEY=

# Retrieval UI
CODENOVA_UI_HOST=127.0.0.1
CODENOVA_UI_PORT=7860

# Gemini (VQA/TRAKE agent, query translation) — optional, falls back to local backends
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Self-hosted VLM (captioning + OCR), OpenAI-compatible.
# Port 8881 is shared by two mutually exclusive docker-compose services —
# `make vllm-index` (Qwen3.6-35B-A3B, for this) or `make vllm-retrieval`
# (Qwen3.5-9B, for agent/serve-ui) — only one runs at a time. VLLM_MODEL here
# is just for logging; whichever container is actually running answers requests.
VLLM_BASE_URL=http://localhost:8881/v1
VLLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
# Concurrent requests to vLLM during captioning/OCR (vLLM batches them itself)
CAPTION_WORKERS=8

# VQA/TRAKE agent local backends
INTERNVL_MODEL=OpenGVLab/InternVL3-2B-hf
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=

# Rerankers
BLIP2_RERANKER_MODEL=Salesforce/blip2-itm-vit-g
VIETNAMESE_RERANKER_MODEL=AITeamVN/Vietnamese_Reranker

# Visual embedding models — all three run by default (default for --embedding-models)
EMBEDDING_MODELS=siglip2-large,beit3-base,vietnamese-embedding
SIGLIP2_EMBEDDING_MODEL=siglip2-large
VIETNAMESE_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2

# BEiT-3 checkpoint (local file, not an HF model ID)
BEIT3_CHECKPOINT_DIR=external/BEiT3/checkpoints
BEIT3_CHECKPOINT_FILE=beit3_base_itc_patch16_224.pth
BEIT3_SPM_FILE=beit3.spm

# ASR (gipformer, runs via external/gipformer/ — see its README)
GIPFORMER_QUANTIZE=fp32
GIPFORMER_NUM_THREADS=4
