# Copy to .env and fill in.

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codenova_frames
QDRANT_API_KEY=

# Elasticsearch (OCR/ASR text index)
ELASTIC_URL=http://localhost:8882
ELASTIC_INDEX=codenova_text
ELASTIC_API_KEY=

# Retrieval UI
CODENOVA_UI_HOST=127.0.0.1
CODENOVA_UI_PORT=7860

# Captioning + OCR VLM, OpenAI-compatible. `make vllm-index-up` starts vLLM
# (GB10 only — cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit) on its own port 8881,
# separate from the agent LLM's port 8884 so both can run at once. VLLM_MODEL
# here is just for logging; the running container determines what actually answers.
VLLM_BASE_URL=http://localhost:8881/v1
VLLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
# Concurrent requests to the VLM during captioning/OCR (it batches them itself)
CAPTION_WORKERS=8

# Agent LLM (VQA/TRAKE answering + interactive chat + query translation).
# Docker-only: `make agent-up` starts vLLM (DGX Spark/GB10, AWQ 4-bit) or
# llama.cpp (other NVIDIA GPUs, GGUF Q4_K_M) — both Qwen3.5-4B, both serving
# OpenAI-compatible /v1 on port 8884. No in-process model loading anywhere.
AGENT_LOCAL_ENGINE_URL=http://localhost:8884/v1
AGENT_LOCAL_ENGINE_MODEL=
# Overrides for docker-compose.yml's vllm-agent/llamacpp-agent default models
VLLM_AGENT_MODEL=cyankiwi/Qwen3.5-4B-AWQ-4bit
LLAMACPP_MODEL=unsloth/Qwen3.5-4B-GGUF:Q4_K_M
# Override for docker-compose.yml's vllm-index (captioning/OCR) default model
VLLM_INDEX_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit

# Rerankers
BLIP2_RERANKER_MODEL=Salesforce/blip2-itm-vit-g
VIETNAMESE_RERANKER_MODEL=AITeamVN/Vietnamese_Reranker

# Visual embedding — BEiT-3 large only by default (default for --embedding-models).
# siglip2 (so400m-384) and vietnamese-embedding stay available as opt-in extras:
# EMBEDDING_MODELS=beit3-large,siglip2-so400m,vietnamese-embedding
EMBEDDING_MODELS=beit3-large
SIGLIP2_EMBEDDING_MODEL=siglip2-so400m
VIETNAMESE_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2

# BEiT-3 checkpoint (local file, not an HF model ID; auto-downloaded on first use)
BEIT3_CHECKPOINT_DIR=external/BEiT3/checkpoints
BEIT3_CHECKPOINT_FILE=beit3_large_patch16_384_coco_retrieval.pth
BEIT3_SPM_FILE=beit3.spm

# TensorRT FP16 acceleration for the BEiT-3/SigLIP2 vision towers (5-27x
# faster than PyTorch eager on this project's GB10, cosine similarity
# >=0.9999 vs PyTorch). First embed-frames run auto-exports ONNX + builds the
# engine under weights/<model>/ (one-time, a few minutes); later runs just
# load the cached engine. Set to "0" to force PyTorch (e.g. if tensorrt isn't
# installed, or an engine build fails on unusual hardware).
BEIT3_USE_TENSORRT=1
SIGLIP2_USE_TENSORRT=1
# Override where exported ONNX/TensorRT files are cached (default: weights/ at repo root)
TENSORRT_WEIGHTS_DIR=weights

# ASR (gipformer, runs via external/gipformer/ — see its README)
GIPFORMER_QUANTIZE=fp32
GIPFORMER_NUM_THREADS=4
# Silero-VAD (speech segmentation ahead of ASR) + word-count chunk regrouping
ASR_VAD_MIN_SILENCE_MS=250
ASR_VAD_SPEECH_PAD_MS=200
ASR_VAD_THRESHOLD=0.5
ASR_VAD_NUM_THREADS=4
ASR_TARGET_WORDS=150
