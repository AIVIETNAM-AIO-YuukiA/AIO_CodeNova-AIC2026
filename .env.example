# Copy to .env and fill in. Real OS environment variables override these.
# This file holds INFRASTRUCTURE config (service endpoints, ports, credentials).
# Per-experiment settings (clip model, keyframe percentiles, top-k) are CLI flags
# recorded in runs/<experiment>/config.json for reproducibility — not here.

# --- Vector database (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codenova_frames
QDRANT_API_KEY=

# --- Full-text index (Elasticsearch, for OCR/ASR — not yet wired into the pipeline) ---
ELASTIC_URL=http://localhost:9200
ELASTIC_INDEX=codenova_text
ELASTIC_API_KEY=

# --- Retrieval UI ---
CODENOVA_UI_HOST=127.0.0.1
CODENOVA_UI_PORT=7860

# --- LLM / VLM APIs (FUTURE — query expansion, OCR correction; no code reads these yet) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
