# Copy sang .env rồi điền giá trị thật.

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codenova_frames
QDRANT_API_KEY=

# Elasticsearch (index chữ cho OCR/ASR/caption)
ELASTIC_URL=http://localhost:8882
ELASTIC_INDEX=codenova_text
ELASTIC_API_KEY=

# UI tìm kiếm
CODENOVA_UI_HOST=127.0.0.1
CODENOVA_UI_PORT=7860

# VLM cho Captioning + OCR (cần model đọc được ảnh), gọi qua OpenRouter
# Số request đồng thời gửi VLM lúc caption/OCR
CAPTION_WORKERS=8

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_API_KEY=
# Model text-only cho mở rộng/phân tách câu truy vấn. Bỏ trống = dùng chung OPENROUTER_MODEL.
OPENROUTER_MODEL_FOR_CHAT=
# Ép đúng provider host cho OPENROUTER_MODEL_FOR_CHAT (vd "relace"). Bỏ trống = để OpenRouter tự chọn.
OPENROUTER_PROVIDER_FOR_CHAT=

# Grounded multi-frame VQA; model must accept images (empty = OPENROUTER_MODEL).
VQA_OPENROUTER_MODEL=
VQA_RETRIEVAL_POOL=100
VQA_CANDIDATE_COUNT=3
VQA_FRAMES_PER_CANDIDATE=6
VQA_EVENT_GAP_SEC=60
VQA_MOMENT_SPAN_SEC=180
VQA_MIN_CONFIDENCE=0.65
VQA_IMAGE_DETAIL=high

# Model cho ReAct agent/legacy Agent chat. Bỏ trống = dùng chung OPENROUTER_MODEL.
AGENT_LOCAL_ENGINE_MODEL=

# Reranker. "blip2" = load trong process (transformers). "qwen-vl-vllm" = gọi
# HTTP tới vLLM riêng (docker-compose service vllm-reranker, cần GPU thật).
RERANKER_BACKEND=blip2
BLIP2_RERANKER_MODEL=Salesforce/blip2-itm-vit-g
VIETNAMESE_RERANKER_MODEL=AITeamVN/Vietnamese_Reranker
QWEN_VL_RERANKER_URL=http://localhost:8884
QWEN_VL_RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-2B

# Embedding hình ảnh. Có thể thêm: beit3-large, siglip2-so400m, vietnamese-embedding
EMBEDDING_MODELS=jina-clip-v2
JINA_EMBEDDING_MODEL=jinaai/jina-clip-v2
SIGLIP2_EMBEDDING_MODEL=google/siglip2-so400m-patch14-384
VIETNAMESE_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2

# Checkpoint BEiT-3 (file local, tự tải lần đầu dùng)
BEIT3_CHECKPOINT_DIR=external/BEiT3/checkpoints
BEIT3_CHECKPOINT_FILE=beit3_large_patch16_384_coco_retrieval.pth
BEIT3_SPM_FILE=beit3.spm

# TensorRT FP16 cho BEiT-3/Jina/SigLIP2 (nhanh hơn PyTorch, tự build engine lần đầu). "0" = ép dùng PyTorch.
BEIT3_USE_TENSORRT=1
JINA_USE_TENSORRT=0
SIGLIP2_USE_TENSORRT=0
TENSORRT_WEIGHTS_DIR=weights

# ASR (gipformer, checkpoint tự tải từ Hugging Face)
GIPFORMER_MODEL=g-group-ai-lab/gipformer-65M-rnnt
GIPFORMER_QUANTIZE=fp32
GIPFORMER_NUM_THREADS=4
# Silero-VAD tách đoạn tiếng nói trước ASR
ASR_VAD_MIN_SILENCE_MS=250
ASR_VAD_SPEECH_PAD_MS=200
ASR_VAD_THRESHOLD=0.5
ASR_VAD_NUM_THREADS=4
ASR_TARGET_WORDS=150
